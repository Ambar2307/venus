generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  EXCLUSIVE
}

enum ProfileType {
  COUPLE
  SINGLE_WOMAN
  SINGLE_MAN
}

enum PhotoVisibility {
  PUBLIC
  FRIENDS
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  birthDate      DateTime
  plan           Plan      @default(FREE)
  planValidUntil DateTime?
  status         String    @default("active")
  createdAt      DateTime  @default(now())

  profile           Profile?
  photos            Photo[]
  likes             Like[]
  comments          Comment[]
  dailyUsage        DailyUsage[]
  sentRequests      FriendRequest[] @relation("sent")
  receivedRequests  FriendRequest[] @relation("received")
  messages          Message[]
  conversationsA    Conversation[]  @relation("partA")
  conversationsB    Conversation[]  @relation("partB")
}

model Profile {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id])
  displayName String
  type        ProfileType
  interest    String
  description String?
}

model Photo {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  url              String
  caption          String?
  visibility       PhotoVisibility   @default(PUBLIC)
  moderationStatus ModerationStatus  @default(PENDING)
  createdAt        DateTime          @default(now())

  likes    Like[]
  comments Comment[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, photoId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

// contador de uso diário — é o que faz valer o limite de 3/dia do plano Livre
model DailyUsage {
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime @db.Date
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)

  @@id([userId, date])
}

model FriendRequest {
  id        String               @id @default(uuid())
  fromId    String
  from      User                 @relation("sent", fields: [fromId], references: [id])
  toId      String
  to        User                 @relation("received", fields: [toId], references: [id])
  status    FriendRequestStatus  @default(PENDING)
  createdAt DateTime             @default(now())

  @@unique([fromId, toId])
}

model Conversation {
  id        String    @id @default(uuid())
  partAId   String
  partA     User      @relation("partA", fields: [partAId], references: [id])
  partBId   String
  partB     User      @relation("partB", fields: [partBId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([partAId, partBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  sentAt         DateTime     @default(now())
  readAt         DateTime?
}
